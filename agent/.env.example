# --- BugStalker agent environment ---
# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Groq API key (fast detection pass). Get it: https://console.groq.com -> API Keys
GROQ_API_KEY=

# Google Gemini API key (reasoning / fix generation). Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults live in app/config.py; names change often).
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
